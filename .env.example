# Copie para .env e preencha. NUNCA versione o .env com valores reais.

# Provedor e modelo no formato aceito por langchain.chat_models.init_chat_model
LLM_PROVIDER=google_genai
LLM_MODEL=gemini-2.5-flash

# Chave do provedor (Google AI Studio: https://aistudio.google.com/app/apikey)
GOOGLE_API_KEY=coloque-sua-chave-aqui

# Tempo máximo por chamada ao LLM e número máximo de tentativas em analisar_chamado
LLM_TIMEOUT_SEGUNDOS=30
MAX_TENTATIVAS_LLM=2
# Espera (s) antes de nova tentativa em erro de quota (429); dobra a cada tentativa, máx. 30
LLM_BACKOFF_BASE_SEGUNDOS=2

# Limiar mínimo de score BM25 para considerar um artigo relevante
LIMIAR_BM25=1.0
# Confiança mínima da análise; abaixo disso o chamado exige revisão humana
LIMIAR_CONFIANCA=0.6

# Logs: nível e formato (json | texto). Arquivos ficam em logs/<run_id>.jsonl
LOG_NIVEL=INFO
LOG_FORMATO=json

# Simula indisponibilidade do catálogo de serviços para demonstrar falha de integração (0 | 1)
SIMULAR_FALHA_TOOL=0
